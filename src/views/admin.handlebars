<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f4; }
        .container { max-width: 800px; margin: 20px auto; padding: 0 20px; }
        h1 { color: #333; text-align: center; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; border: 1px solid #ddd; text-align: left; }
        th { background-color: #f4f4f4; }
        .btn { padding: 8px 12px; cursor: pointer; }
        .btn-danger { background-color: #e74c3c; color: white; }
        .btn-primary { background-color: #3498db; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Admin Panel</h1>

        <button class="btn btn-clear" id="clear-inactive-btn">Delete Inactive Users</button>

        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each users}}
                <tr>
                    <td>{{this.first_name}} {{this.last_name}}</td>
                    <td>{{this.email}}</td>
                    <td>
                        <select data-user-id="{{this._id}}" class="user-role-select">
                            <option value="user" {{#if this.role}}{{this.role}}{{/if}}>User</option>
                            <option value="admin" {{#if this.role}}{{this.role}}{{/if}}>Admin</option>
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-danger delete-user-btn" data-user-id="{{this._id}}">Delete</button>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.user-role-select').forEach(select => {
                select.addEventListener('change', async function() {
                    const userId = this.getAttribute('data-user-id');
                    const newRole = this.value;
                    try {
                        const response = await fetch(`/api/users/${userId}/role`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ role: newRole })
                        });
                        if (!response.ok) {
                            throw new Error('Failed to update role');
                        }
                        alert('Role updated successfully');
                    } catch (error) {
                        console.error('Error updating role:', error);
                        alert('Error updating role');
                    }
                });
            });

            document.querySelectorAll('.delete-user-btn').forEach(button => {
                button.addEventListener('click', async function() {
                    const userId = this.getAttribute('data-user-id');
                    if (confirm('Are you sure you want to delete this user?')) {
                        try {
                            const response = await fetch(`/api/users/${userId}`, { method: 'DELETE' });
                            if (!response.ok) {
                                throw new Error('Failed to delete user');
                            }
                            alert('User deleted successfully');
                            location.reload();
                        } catch (error) {
                            console.error('Error deleting user:', error);
                            alert('Error deleting user');
                        }
                    }
                });
            });

            // Delete all inactive users 
            const clearInactiveBtn = document.getElementById('clear-inactive-btn');
            clearInactiveBtn.addEventListener('click', async function() {
                if (confirm('Are you sure you want to delete all inactive users?')) {
                    try {
                        const response = await fetch(`/api/users/inactive`, { method: 'DELETE' });
                        if (!response.ok) {
                            throw new Error('Failed to delete inactive users');
                        }
                        alert('Inactive users deleted successfully');
                        location.reload();
                    } catch (error) {
                        console.error('Error deleting inactive users:', error);
                        alert('Error deleting inactive users');
                    }
                }
            });
        });
    </script>
</body>
</html>




